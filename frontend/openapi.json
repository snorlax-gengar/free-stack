{
  "openapi": "3.1.0",
  "info": {
    "title": "FreeStack",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "post": {
        "summary": "Create Recommendation",
        "operationId": "create_recommendation_api_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "422": {
            "description": "The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "An internal error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignmentResponse": {
        "properties": {
          "feature": {
            "$ref": "#/components/schemas/Feature"
          },
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "status": {
            "$ref": "#/components/schemas/EvaluationStatus"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "plan_id",
          "status"
        ],
        "title": "AssignmentResponse"
      },
      "BlockReason": {
        "type": "string",
        "enum": [
          "no-candidates",
          "all-incompatible"
        ],
        "title": "BlockReason",
        "description": "Why one role cannot be assigned a plan.\n\n``no-candidates`` means the role has no evaluated plans.\n``all-incompatible`` means every evaluated plan for the role is incompatible.\nA plan that lacks the role capability is not an evaluated candidate."
      },
      "BlockedRoleResponse": {
        "properties": {
          "feature": {
            "$ref": "#/components/schemas/Feature"
          },
          "reason": {
            "$ref": "#/components/schemas/BlockReason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "feature",
          "reason"
        ],
        "title": "BlockedRoleResponse"
      },
      "CapabilityKey": {
        "type": "string",
        "enum": [
          "static-hosting",
          "server-compute",
          "serverless-functions",
          "database",
          "file-storage",
          "authentication",
          "realtime",
          "scheduled-jobs"
        ],
        "title": "CapabilityKey",
        "description": "Fixed capability vocabulary. This is not a stored entity."
      },
      "CaveatResponse": {
        "properties": {
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "statement": {
            "type": "string",
            "title": "Statement"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan_id",
          "statement",
          "source_id"
        ],
        "title": "CaveatResponse"
      },
      "CheckOutcome": {
        "type": "string",
        "enum": [
          "satisfied",
          "violated",
          "unknown"
        ],
        "title": "CheckOutcome",
        "description": "Whether one need is met, unmet, or not decidable."
      },
      "CheckResponse": {
        "properties": {
          "reason_code": {
            "$ref": "#/components/schemas/ReasonCode"
          },
          "outcome": {
            "$ref": "#/components/schemas/CheckOutcome"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reason_code",
          "outcome"
        ],
        "title": "CheckResponse"
      },
      "CompositionResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CompositionStatus"
          },
          "compatible": {
            "items": {
              "$ref": "#/components/schemas/StackResponse"
            },
            "type": "array",
            "title": "Compatible"
          },
          "unknown": {
            "items": {
              "$ref": "#/components/schemas/StackResponse"
            },
            "type": "array",
            "title": "Unknown"
          },
          "incompatible": {
            "items": {
              "$ref": "#/components/schemas/StackResponse"
            },
            "type": "array",
            "title": "Incompatible"
          },
          "blocked_roles": {
            "items": {
              "$ref": "#/components/schemas/BlockedRoleResponse"
            },
            "type": "array",
            "title": "Blocked Roles"
          },
          "combination_count": {
            "type": "integer",
            "title": "Combination Count"
          },
          "unevaluated_features": {
            "items": {
              "$ref": "#/components/schemas/Feature"
            },
            "type": "array",
            "title": "Unevaluated Features"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "compatible",
          "unknown",
          "incompatible",
          "blocked_roles",
          "combination_count",
          "unevaluated_features"
        ],
        "title": "CompositionResponse"
      },
      "CompositionStatus": {
        "type": "string",
        "enum": [
          "composed",
          "blocked",
          "too-many-combinations",
          "no-roles"
        ],
        "title": "CompositionStatus",
        "description": "Whether composition produced stacks. This does not rank them."
      },
      "ErrorObject": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorObject",
        "description": "Stable error code and message. This object has no diagnostic details."
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorObject"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "description": "HTTP body for a recommendation API error."
      },
      "EvaluationStatus": {
        "type": "string",
        "enum": [
          "compatible",
          "unknown",
          "incompatible"
        ],
        "title": "EvaluationStatus",
        "description": "Aggregated check status for one plan in one role.\n\n``compatible`` means the stated checks are not violated or unknown.\nIt does not rank plans or choose a winner."
      },
      "ExceedBehavior": {
        "type": "string",
        "enum": [
          "charged",
          "suspended",
          "restricted"
        ],
        "title": "ExceedBehavior",
        "description": "What can happen when included usage is exceeded.\n\nThis is a plan-level set, not a per-metric model."
      },
      "Feature": {
        "type": "string",
        "enum": [
          "static-frontend",
          "backend-server",
          "backend-functions",
          "database",
          "file-uploads",
          "authentication",
          "realtime",
          "scheduled-jobs",
          "ai-api"
        ],
        "title": "Feature",
        "description": "A project capability the user asked for.\n\nThis is not a catalog ``CapabilityKey``. Some features have no catalog\ncapability and stay unevaluated."
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LimitMetric": {
        "type": "string",
